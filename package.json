    "test:anime-integration": "node --import ./scripts/test-loader.mjs scripts/check-anime-integration.mjs",
    "test:anime-scene": "node --import ./scripts/test-loader.mjs scripts/check-anime-cinema.mjs",
    "test:anime-journey": "node --import ./scripts/test-loader.mjs scripts/check-anime-journey.mjs",
    "test:anime-cinema": "node --import ./scripts/test-loader.mjs scripts/check-anime-cinema.mjs",
    "test:anime-cinema-runtime": "node --import ./scripts/test-loader.mjs scripts/check-anime-cinema-runtime.mjs",
    "test:live-sync": "node --import ./scripts/test-loader.mjs --test scripts/check-live-sync.mjs"
